# AEGIS production environment template.
# Copy to .env and replace every placeholder before deploying.

APP_ENV=production
CORS_ALLOW_ORIGINS=https://aegis.example.com
AEGIS_DATA_DIR=/app/data

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=replace-with-kraft-cluster-id

POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-strong-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key
MINIO_BUCKET=aegis-models

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AEGIS_ALLOW_DEMO_AUTH=false

FORECASTING_SERVICE_URL=http://forecasting:8001
ANOMALY_SERVICE_URL=http://anomaly:8002
RL_AGENT_SERVICE_URL=http://rl-agent:8003
DR_SERVICE_URL=http://demand-response:8004
API_GATEWAY_PORT=8000

SIMULATION_SPEED_FACTOR=60
SIMULATION_START_DATE=2024-01-01
SIMULATION_END_DATE=2024-12-31

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password

